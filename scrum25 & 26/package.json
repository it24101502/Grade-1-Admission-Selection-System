{
  "name": "category-access-app",
  "version": "1.0.0",
  "private": true,
  "description": "Category-based application access control",
  "scripts": {
    "install:all": "npm install && npm install --prefix src/client",
    "dev": "concurrently \"nodemon src/server/index.js\" \"npm start --prefix src/client\"",
    "start": "node src/server/index.js",
    "test": "jest --coverage --testPathPattern=src/__tests__",
    "build": "npm run build --prefix src/client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "jest": "^29.5.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
